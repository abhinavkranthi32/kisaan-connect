# KISSAN CONNECT - ENVIRONMENT CONFIGURATION (SIH 2024-2026)
PORT=3000

# 1. Government AGMARKNET / data.gov.in API Key
# Resource: Daily Mandi Prices for Agricultural Commodities in Telangana
# Obtain key from: https://data.gov.in/
DATA_GOV_IN_API_KEY=

# 2. Weather API Key (Optional)
# Primary weather uses Open-Meteo (No API key needed, high-accuracy WMO data)
# Optional fallback: OpenWeatherMap
WEATHER_API_KEY=

# 3. Maps & Routing API Key (Optional)
# Primary distance/ETA uses Open Source Routing Machine (OSRM, No key needed)
# Optional fallback: Google Maps Platform / Mapbox
MAPS_API_KEY=

# 4. Google Gemini API Key (Optional)
# For AI Market Advisor & Crop Quality Scanner
GEMINI_API_KEY=
