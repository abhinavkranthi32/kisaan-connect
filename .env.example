# KISSAN CONNECT - ENVIRONMENT CONFIGURATION (SIH 2024-2026)
PORT=3000

# 1. Government AGMARKNET / data.gov.in API Key
DATA_GOV_IN_API_KEY=

# 2. Weather API Key (Optional)
WEATHER_API_KEY=

# 3. Maps & Routing API Key (Optional)
MAPS_API_KEY=

# 4. Google Gemini API Key (Optional)
GEMINI_API_KEY=

# 5. Presentation Mode
ENABLE_DEMO_LOGIN=false

# 6. Supabase Credentials (Cloud PostgreSQL Engine)
# Obtain from: https://app.supabase.com -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
